PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/parkspot?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_strong_random_secret_min_32_chars_here
JWT_EXPIRE=7d
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
CLIENT_URL=https://your-app-name.onrender.com
# Optional: comma-separated extra frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Real-time field testing: owner uploads go live instantly (set false in production for admin approval)
INSTANT_APPROVE=true
